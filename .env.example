# Corpus Builder — API Keys and Configuration
#
# Copy this file to `.env` and fill in your own credentials.
# Never commit .env to version control.

# ----------------------------------------------------------------------------
# Publisher APIs (for PDF download)
# ----------------------------------------------------------------------------

# Wiley Text and Data Mining (TDM) API token
# Register at: https://onlinelibrary.wiley.com/library-info/resources/text-and-datamining
# Requires an ORCID and acceptance of the Wiley TDM click-through license.
WILEY_TDM_TOKEN=your_wiley_tdm_token_here

# Elsevier API key (ScienceDirect full-text retrieval)
# Register at: https://dev.elsevier.com/apikey/manage
# Full-text access requires your institution to have a ScienceDirect subscription.
ELSEVIER_API_KEY=your_elsevier_api_key_here

# Springer Nature API keys
# Register at: https://dev.springernature.com/
# Two separate keys: one for Open Access API, one for Meta API.
SPRINGER_OA_API_KEY=your_springer_openaccess_key_here
SPRINGER_META_API_KEY=your_springer_meta_key_here

# ----------------------------------------------------------------------------
# LLM API (for knowledge graph extraction, script 05)
# ----------------------------------------------------------------------------

# OpenAI API key (used by 05_extract_kg.py for triplet extraction)
# Register at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ----------------------------------------------------------------------------
# HTTP identification (required by most publisher APIs and Unpaywall)
# ----------------------------------------------------------------------------

# Contact email — sent in the User-Agent header and as the `email`
# parameter to the Unpaywall API (Unpaywall requires a real address per
# its terms of use). Identifies your traffic to publishers honestly.
CONTACT_EMAIL=your.email@your-institution.org

# User-Agent string for all outbound HTTP requests. The pipeline does not
# spoof browsers; this string is meant to identify the tool truthfully.
# Convention: "<project>/<version> (mailto:<email>)"
USER_AGENT=CorpusBuilder/1.0 (mailto:your.email@your-institution.org)
